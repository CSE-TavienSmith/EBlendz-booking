# Copy to .env.local for local dev, and add the same keys in Vercel for production.

# "sandbox" for testing, "production" for the live site
SQUARE_ENVIRONMENT=sandbox

# Square Developer dashboard -> your app -> Credentials / OAuth
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Square Dashboard -> Settings -> Locations
SQUARE_LOCATION_ID=

# Filled in after the one-time connect at /api/oauth/start
SQUARE_REFRESH_TOKEN=

# Set to "true" only while running the one-time connect, then back to "false"
SQUARE_OAUTH_SETUP=false
